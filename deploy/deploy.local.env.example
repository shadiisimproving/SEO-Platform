# Copy to deploy/deploy.local.env on the computer that uploads, and fill it in. That file is never committed.
SSH_USER=your-cpanel-user
SSH_HOST=your-server.example.net
SSH_KEY=$HOME/.ssh/your_deploy_key
PUBLIC_URL=https://seo.example.com
# Where the hosting's Python app lives, as cPanel's "Setup Python App" shows it:
VENV_BIN=/home/your-cpanel-user/virtualenv/seo-platform/3.12/bin
# Optional: SSH_PORT=22, APP_NAME=seo-platform, KNOWN_HOSTS_FILE=deploy/known_hosts.local
# Optional, for scripts/pull_backups.sh (the copy of the backups on this Mac): BACKUP_COPY_DIR=$HOME/Backups/seo-command-center
